# Order Service configuration
PORT=8082
LOG_LEVEL=info

# Dedicated PostgreSQL (order-db container in docker-compose.yml)
POSTGRES_USER=order_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=orders_db
# Used when running the binary outside docker (compose overrides the host):
DATABASE_URL=postgres://order_user:YOUR_PASSWORD@localhost:5433/orders_db?sslmode=disable

# Shared HS256 secret — MUST be identical to auth-service JWT_SECRET
JWT_SECRET=YOUR_SECRET_KEY_HERE

# Stripe TEST mode key (sk_test_...). Leave empty to use the built-in fake
# gateway (offline demo mode).
STRIPE_SECRET_KEY=
